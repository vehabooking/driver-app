# ─────────────────────────────────────────────────────────────
# Veha Driver — runtime configuration
#
# Change APP_URL here, then rebuild the app. Nothing else to edit.
#
#   local    http://192.168.1.4:8000  (php artisan serve --host=0.0.0.0 --port=8000)
#   staging  https://staging.app.vehabooking.com
#   prod     https://app.vehabooking.com
#
# Host only — NO trailing slash and NO /api suffix. The app appends its
# own prefixes (/api/driver/v1, /api/taxi/v1/driver, /api/v1/platform/...).
# ─────────────────────────────────────────────────────────────

APP_URL=http://192.168.1.4:8000
